# PostgreSQL dedicado ao projeto. Use uma base de homologação antes da produção.
DATABASE_URI=postgresql://connect:connect@localhost:5432/connect
# Gere um segredo aleatório forte; não use este valor em produção.
PAYLOAD_SECRET=substitua-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
NEXT_PUBLIC_APP_URL=http://localhost:3000
# false: aplicar alterações com npm run db:migrate.
# true: permitido SOMENTE para banco descartável de desenvolvimento.
PAYLOAD_DB_PUSH=false

# Zoom OAuth gerenciado pelo usuário: login e leitura do próprio perfil.
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/zoom/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Credenciais do Meeting SDK. Na ausência, utiliza as credenciais acima.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
# Segredo da assinatura dos webhooks (não é o client secret OAuth).
ZOOM_WEBHOOK_SECRET_TOKEN=
# Opcional: rejeita eventos de outra conta Zoom.
ZOOM_ACCOUNT_ID=

# Apenas para npm run admin:create. Nunca reutilize uma senha pública de exemplo.
ADMIN_NAME=Trader
ADMIN_EMAIL=
ADMIN_PASSWORD=
