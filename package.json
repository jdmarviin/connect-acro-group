{
  "name": "connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "supabase:status": "node --import tsx scripts/supabase-schema.ts",
    "supabase:inspect": "node --import tsx scripts/supabase-schema.ts --inspect",
    "supabase:migrate": "node --import tsx scripts/supabase-schema.ts --apply",
    "supabase:test": "node --import tsx --test tests/supabase.test.ts",
    "supabase:verify": "node --import tsx scripts/verify-supabase.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.43.0",
    "next": "15.5.25",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^8",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4"
  },
  "type": "module",
  "overrides": {
    "postcss": "$postcss"
  }
}
