{
  "name": "connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "payload migrate",
    "db:migrate:create": "payload migrate:create",
    "generate:types": "payload generate:types",
    "admin:create": "payload run scripts/create-admin.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@zoom/meetingsdk": "^6.2.0",
    "cross-env": "^10.1.0",
    "graphql": "16.14.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.43.0",
    "next": "15.5.25",
    "payload": "3.89.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^8",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4"
  },
  "type": "module",
