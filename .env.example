# PostgreSQL dedicado ao projeto. Use uma base de homologação antes da produção.
DATABASE_URI=postgresql://connect:connect@localhost:5432/connect
# O backend da aplicação é exclusivamente Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://vlktqilzuvawrkyyunge.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# DATABASE_URI atende tanto o legado public quanto o novo schema connect.
# Usada somente pelo script administrativo de migração Auth, nunca no navegador.
SUPABASE_SECRET_KEY=
# Segredo aleatório com pelo menos 32 caracteres, estável entre implantações.
ZOOM_TOKEN_ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zoom OAuth gerenciado pelo usuário: login e leitura do próprio perfil.
# Redirect URI no Zoom: https://<projeto>.supabase.co/auth/v1/callback
# No Supabase: permitir <NEXT_PUBLIC_APP_URL>/api/auth/zoom/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# O Meeting SDK usa o mesmo par acima: CLIENT_ID como sdkKey e CLIENT_SECRET como sdkSecret.
# Segredo da assinatura dos webhooks (não é o client secret OAuth).
ZOOM_WEBHOOK_SECRET_TOKEN=
# Opcional: rejeita eventos de outra conta Zoom.
ZOOM_ACCOUNT_ID=

# No aplicativo Zoom OAuth, habilite leitura de perfil/PMI, leitura e criação
# de reuniões, exclusão (compensação de falha) e leitura do token ZAK.
# Após alterar os escopos, owner e admins devem autorizar novamente pelo login.
